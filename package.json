{
  "name": "tamv-mdx4",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TAMV MD-X4 - Next Generation Metaverse Platform",
  "author": "Edwin Oswaldo Castillo Trejo",
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "build:analyze": "vite build --analyze",
    "preview": "vite preview",
    
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:staged": "lint-staged",
    "lint:quiet": "eslint . --quiet --ext .ts,.tsx",
    
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json,html}\"",
    
    "typecheck": "tsc --noEmit",
    "typecheck:full": "tsc --noEmit --pretty",
    
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    
    "prepare": "husky install",
    "precommit": "lint-staged",
    
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run build",
    
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules",
    
    "validate": "npm run check",
    
    "docs:generate": "typedoc",
    "docs:preview": "npx serve docs",
    
    "docker:build": "docker build -t tamv-mdx4 .",
    "docker:run": "docker run -p 3000:3000 tamv-mdx4",
    "docker:compose": "docker-compose up",
    
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:status": "kubectl get pods -n tamv",
    "k8s:logs": "kubectl logs -f deployment/tamv -n tamv"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.62.7",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.1",
    "framer-motion": "^11.15.0",
    "input-otp": "^1.4.1",
    "lovable-tagger": "^1.1.13",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.4.4",
    "react": "^18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.170.0",
    "vaul": "^1.1.2",
    "vite": "^7.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.4",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-testing-library": "^6.4.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.6",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.10",
    "msw": "^2.7.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typedoc": "^0.27.2",
    "typescript": "^5.7.2",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
